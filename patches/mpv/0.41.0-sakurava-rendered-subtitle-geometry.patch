+        if (obj->type == OSDTYPE_SUB)
+            update_primary_subtitle_geometry(osd, obj, res, imgs);
+
         stats_time_end(osd->stats, stat_type_render);
 
         if (imgs && imgs->num_parts > 0) {
@@ -528,6 +565,16 @@ struct mp_osd_res osd_get_vo_res(struct osd_state *osd)
     return res;
 }
 
+bool osd_get_primary_subtitle_geometry(
+    struct osd_state *osd, struct osd_subtitle_geometry *out_geometry)
+{
+    mp_mutex_lock(&osd->lock);
+    *out_geometry = osd->primary_subtitle_geometry;
+    bool valid = out_geometry->valid;
+    mp_mutex_unlock(&osd->lock);
+    return valid;
+}
