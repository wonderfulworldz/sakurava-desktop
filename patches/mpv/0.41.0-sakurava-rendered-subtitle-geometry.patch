diff --git a/sub/osd.c b/sub/osd.c
index 2788897..97ea47b 100644
--- a/sub/osd.c
+++ b/sub/osd.c
@@ -354,6 +354,40 @@ static struct sub_bitmaps *render_object(struct osd_state *osd,
     return res;
 }
 
+static void update_primary_subtitle_geometry(
+    struct osd_state *osd, struct osd_object *obj,
+    struct mp_osd_res output, struct sub_bitmaps *imgs)
+{
+    struct osd_subtitle_geometry geometry = {
+        .output_w = output.w,
+        .output_h = output.h,
+        .change_id = obj->vo_change_id,
+    };
+
+    if (imgs && imgs->num_parts > 0) {
+        int x0 = INT_MAX;
+        int y0 = INT_MAX;
+        int x1 = INT_MIN;
+        int y1 = INT_MIN;
+        for (int n = 0; n < imgs->num_parts; n++) {
+            struct sub_bitmap *part = &imgs->parts[n];
+            x0 = MPMIN(x0, part->x);
+            y0 = MPMIN(y0, part->y);
+            x1 = MPMAX(x1, part->x + part->dw);
+            y1 = MPMAX(y1, part->y + part->dh);
+        }
+        if (x1 > x0 && y1 > y0) {
+            geometry.valid = true;
+            geometry.x = x0;
+            geometry.y = y0;
+            geometry.w = x1 - x0;
+            geometry.h = y1 - y0;
+        }
+    }
+
+    osd->primary_subtitle_geometry = geometry;
+}
+
