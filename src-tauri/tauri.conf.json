{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sakurava",
  "version": "0.0.0",
  "identifier": "app.sakurava.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sakurava",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
